# ---------------------------------------------------------------------------
# Agent worker environment (agent.py, make_call.py, the trunk scripts)
#
# Copy to `.env` and fill in. The dashboard has its own file —
# see dashboard/.env.example.
# ---------------------------------------------------------------------------

# --- LiveKit (https://cloud.livekit.io/) -----------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# --- Speech-to-text: Deepgram (https://console.deepgram.com/) --------------
# Always required — the agent transcribes every call with it.
DEEPGRAM_API_KEY=your_deepgram_key

# --- Language model --------------------------------------------------------
# LLM_PROVIDER is the default; the dashboard can override it per call.
LLM_PROVIDER=groq

# Needed when the provider is "groq" (https://console.groq.com/)
GROQ_API_KEY=your_groq_key
GROQ_MODEL=llama-3.3-70b-versatile

# Needed when the provider is "openai", and for the Alloy/Echo/Shimmer voices
OPENAI_API_KEY=your_openai_key

# --- Text-to-speech --------------------------------------------------------
# "openai" (Alloy/Echo/Shimmer), "sarvam" (Indian voices), "cartesia", "deepgram"
TTS_PROVIDER=openai

# Needed for the Anushka / Aravind voices (https://dashboard.sarvam.ai/)
SARVAM_API_KEY=your_sarvam_key

# --- SIP trunking ----------------------------------------------------------
# Create a trunk with `python create_trunk.py`, list them with `python list_trunks.py`
VOBIZ_SIP_TRUNK_ID=your_trunk_id
OUTBOUND_TRUNK_ID=your_trunk_id  # Usually the same as above
VOBIZ_SIP_DOMAIN=your_sip_domain
VOBIZ_USERNAME=your_sip_username
VOBIZ_PASSWORD=your_sip_password
VOBIZ_OUTBOUND_NUMBER=+91XXXXXXXXXX

# Where `transfer_call` sends the caller when no destination is given
DEFAULT_TRANSFER_NUMBER=+91XXXXXXXXXX

# --- Worker tuning ---------------------------------------------------------
# Machine load above this and the worker stops accepting calls. `agent.py start`
# would otherwise default to 0.7, which a laptop running the dashboard and a
# browser already exceeds — the worker then refuses every job and callees hear
# silence. 1.0 disables the gate; lower it only when several workers share a box
# and one can genuinely hand work to another.
LIVEKIT_LOAD_THRESHOLD=1.0
