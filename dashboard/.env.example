# ---------------------------------------------------------------------------
# Dashboard environment
#
# Local:  copy this file to `dashboard/.env.local` and fill it in.
# Vercel: set the same keys under Settings -> Environment Variables.
#
# These are SERVER-side only (no NEXT_PUBLIC_ prefix), so they are never sent
# to the browser. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# --- Required: LiveKit (https://cloud.livekit.io) --------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Required for phone calls: SIP trunk -----------------------------------
# Create one with `python create_trunk.py`, or list existing trunks with
# `python list_trunks.py`.
VOBIZ_SIP_TRUNK_ID=

# --- Optional: shown in the dashboard header -------------------------------
VOBIZ_OUTBOUND_NUMBER=
DEFAULT_TRANSFER_NUMBER=
